{
  "cleanUrls": true,
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "^/api/(.+)$",
      "dest": "/api/index",
      "transforms": [
        { "type": "request.path", "op": "set", "args": "/api/$1" }
      ]
    }
  ],
  "headers": [
    {
      "source": "/vendor/three/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/showcase/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
