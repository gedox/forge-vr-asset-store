#!/bin/sh
# Git pre-push hook: sync the local store up to the deployed (Vercel) backend before
# pushing. Runs `node bin/sync.js`, which reads storage/ and writes it into Neon + Blob.
#
# It is safe to push without credentials: when DATABASE_URL / BLOB_READ_WRITE_TOKEN are
# missing the sync prints a note and the push goes ahead anyway.
#
# Install (once, per clone) from the repo root:
#   cp scripts/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push

cd "$(dirname "$0")/../.." || exit 0

if [ ! -f .env ] && [ -z "$DATABASE_URL" ]; then
  echo "[sync] no .env found — skipping deployment sync (local changes won't reach Vercel)."
  exit 0
fi

node bin/sync.js
exit $?
